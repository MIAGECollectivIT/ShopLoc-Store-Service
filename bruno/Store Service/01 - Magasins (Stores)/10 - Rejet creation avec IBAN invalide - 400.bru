meta {
  name: 10 - Rejet creation avec IBAN invalide - 400
  type: http
  seq: 10
}

post {
  url: {{baseUrl}}/v1/stores
  body: json
  auth: bearer
}

auth:bearer {
  token: {{merchantToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": "Boulangerie Test",
    "address": "12 rue des Fleurs",
    "category": "Alimentation",
    "rib": "FR7630006000011234567890188"
  }
}

assert {
  res.status: eq 400
  res.body.fieldErrors.rib: isDefined
}
