meta {
  name: 02 - Creer un produit avec photo S3 (multipart) - 201
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/v1/stores/{{storeId}}/products
  body: multipartForm
  auth: bearer
}

auth:bearer {
  token: {{merchantToken}}
}

body:multipartForm {
  product: {"reference":"REF-CROISSANT-AOP","name":"Croissant au beurre AOP","description":"Pur beurre Charentes-Poitou","price":1.50,"stockQuantity":25} [type: application/json]
}

assert {
  res.status: eq 201
  res.body.reference: eq "REF-CROISSANT-AOP"
  res.body.stockQuantity: eq 25
}
