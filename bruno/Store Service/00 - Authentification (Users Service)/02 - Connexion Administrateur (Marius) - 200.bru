meta {
  name: 02 - Connexion Administrateur (Marius) - 200
  type: http
  seq: 2
}

post {
  url: {{usersUrl}}/v1/users/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "USER",
    "password": "PASSWORD"
  }
}

script:post-response {
  if (res.status === 200 && res.body && res.body.token) {
    bru.setEnvVar("adminToken", res.body.token);
  }
}

assert {
  res.status: eq 200
  res.body.token: isDefined
  res.body.user.role: eq ADMIN
}

