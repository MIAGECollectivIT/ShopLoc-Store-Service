meta {
  name: 07 - Rejet creation magasin sans token - 401
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/v1/stores
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": "Boutique Pirate",
    "address": "1 rue Inconnue",
    "category": "Divers",
    "rib": "FR7630006000011234567890189"
  }
}

assert {
  res.status: eq 401
}
