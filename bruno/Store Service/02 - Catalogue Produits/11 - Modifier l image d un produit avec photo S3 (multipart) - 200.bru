meta {
  name: 11 - Modifier l image d un produit avec photo S3 (multipart) - 200
  type: http
  seq: 11
}

patch {
  url: {{baseUrl}}/v1/stores/{{storeId}}/products/{{productId}}/image
  body: multipart-form
  auth: bearer
}

auth:bearer {
  token: {{merchantToken}}
}

body:multipart-form {
  image: @file()
}

assert {
  res.status: eq 200
  res.body.imageUrl: isString
}
