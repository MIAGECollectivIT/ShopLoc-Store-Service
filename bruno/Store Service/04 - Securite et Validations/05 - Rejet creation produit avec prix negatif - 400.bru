meta {
  name: 05 - Rejet creation produit avec prix negatif - 400
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/v1/stores/{{storeId}}/products
  body: json
  auth: bearer
}

auth:bearer {
  token: {{merchantToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "reference": "REF-PRIX-NEG",
    "name": "Produit Prix Négatif",
    "price": -3.50
  }
}

assert {
  res.status: eq 400
  res.body.fieldErrors.price: isDefined
}

