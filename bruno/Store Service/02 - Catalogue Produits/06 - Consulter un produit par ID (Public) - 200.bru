meta {
  name: 06 - Consulter un produit par ID (Public) - 200
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/v1/stores/{{storeId}}/products/{{productId}}
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.body.id: eq {{productId}}
  res.body.reference: isDefined
  res.body.price: isDefined
}
