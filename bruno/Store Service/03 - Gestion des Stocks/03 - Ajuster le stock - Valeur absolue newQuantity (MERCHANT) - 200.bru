meta {
  name: 03 - Ajuster le stock - Valeur absolue newQuantity (MERCHANT) - 200
  type: http
  seq: 3
}

patch {
  url: {{baseUrl}}/v1/stores/{{storeId}}/products/{{productId}}/stock
  body: json
  auth: bearer
}

auth:bearer {
  token: {{merchantToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "newQuantity": 50
  }
}

assert {
  res.status: eq 200
  res.body.stockQuantity: eq 50
}

