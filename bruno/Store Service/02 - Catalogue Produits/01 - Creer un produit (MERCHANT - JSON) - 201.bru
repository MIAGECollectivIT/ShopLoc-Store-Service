meta {
  name: 01 - Creer un produit (MERCHANT - JSON) - 201
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/v1/stores/{{storeId}}/products
  body: json
  auth: bearer
}

auth:bearer {
  token: {{merchantToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "reference": "REF-BAGUETTE-TRAD",
    "name": "Baguette Tradition Label Rouge",
    "description": "Farine de tradition française, fermentation lente de 24h",
    "price": 1.30,
    "imageUrl": "https://cdn.shoploc.fr/products/tradition.jpg",
    "stockQuantity": 30
  }
}

assert {
  res.status: eq 201
  res.body.reference: eq "REF-BAGUETTE-TRAD"
  res.body.name: eq "Baguette Tradition Label Rouge"
  res.body.price: eq 1.30
  res.body.stockQuantity: eq 30
  res.body.id: isDefined
}
