meta {
  name: 03 - Creer un produit (ADMIN) - 201
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/v1/stores/{{storeId}}/products
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "reference": "REF-ADMIN-ARTICLE",
    "name": "Brioche Tressée Pur Beurre",
    "description": "Créé par l'administrateur de la plateforme",
    "price": 4.50,
    "stockQuantity": 15
  }
}

assert {
  res.status: eq 201
  res.body.reference: eq "REF-ADMIN-ARTICLE"
}

