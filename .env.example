# ==============================================================================
# Variables d'environnement - ShopLoc Store Service
# ==============================================================================
# Ce fichier sert de modèle pour la configuration locale.
# Pour l'utiliser, dupliquez-le sous le nom .env :
#   cp .env.example .env
#
# NOTE :
# - En local (Docker Compose), les variables ci-dessous permettent de surcharger
#   les valeurs par défaut (devuser / devpassword / app_db).
# - En production / cluster K3s, les secrets sont injectés directement
#   depuis les Secrets Kubernetes 'db-credentials-store', 's3-credentials-store' et 'jwt-secret'.
# ==============================================================================

# Port d'écoute du service Spring Boot
PORT=8080

# Hôte et port de la base de données PostgreSQL
# - Pour Docker Compose : DB_HOST=db
# - Pour une exécution directe hors Docker (IDE / mvn) : DB_HOST=localhost
DB_HOST=db
DB_PORT=5432

# Identifiants de la base de données PostgreSQL
POSTGRES_DB=app_db
POSTGRES_USER=devuser
POSTGRES_PASSWORD=devpassword

# Variables complémentaires utilisées directement par le backend Spring Boot
DB_NAME=app_db
DB_USER=devuser
DB_PASSWORD=devpassword

# S3 / MinIO Configuration
S3_ENDPOINT=http://minio:9000
S3_BUCKET_NAME=store-images
S3_ACCESS_KEY=devadmin
S3_SECRET_KEY=devpassword123
S3_REGION=us-east-1

# URL du service utilisateur (Users-Service) pour vérification des partenaires et révocation
# - Hors Docker (local) : http://localhost:8080
# - Dans Docker Compose / réseau interne : http://users-service:8080
USERS_SERVICE_URL=http://localhost:8080

# ==============================================================================
# SÉCURITÉ JWT (Vérification Asymétrique RSA RS256)
# ==============================================================================
# Store-Service est un CONSOMMATEUR de jetons : il ne détient JAMAIS de clé privée
# et ne signe aucun jeton. Il vérifie uniquement les signatures avec la clé publique.
# Si non renseignée, la clé publique est récupérée automatiquement depuis Users-Service.

# Clé publique RSA 2048-bit (X.509 SPKI Base64) émise par Users-Service
JWT_PUBLIC_KEY=
