meta {
  name: 01 - Rejet creation produit sans token - 401
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/v1/stores/{{storeId}}/products
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "reference": "REF-ANON-01",
    "name": "Produit Sans Token",
    "price": 2.00
  }
}

assert {
  res.status: eq 401
  res.body.error: eq "Unauthorized"
}
